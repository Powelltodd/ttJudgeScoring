<?xml version="1.0" encoding="UTF-8"?>
<!--
  apps/ttJudgeScoring is a PLAIN FOLDER, not its own IIS application, so
  this is inherited config layered on top of wwwroot/web.config. Keep it to
  the minimum that must differ from the parent — every extra section is a
  chance at a 500.19 override/duplicate conflict for no benefit.

  Deliberately NOT repeated from the parent (wwwroot/web.config):
    - the "Extensionless to html" rewrite rule, which is what makes
      /apps/ttJudgeScoring/index resolve to index.html
    - the .js mimeMap (application/javascript; charset=UTF-8)
    - request size limits
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- The parent sets .js to UTF-8 but says nothing about .html, so
           .html fell through to the IIS default and was served as
           ISO-8859-1. An HTTP Content-Type charset OVERRIDES the document's
           own <meta charset>, so the UTF-8 in these files was decoded as
           Latin-1 and every em dash rendered as three mojibake characters —
           visibly, in the <title>.

           <remove> first is required: .html IS in the inherited collection
           (it comes from applicationHost.config's defaults), and adding a
           duplicate without removing it is a 500.19. That is the opposite
           of the trap noted in apps/LiveMeet/web.config, which is about
           removing an entry that is NOT inherited. -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html; charset=UTF-8" />

      <!-- Don't let browsers cache ANYTHING here, .js included — same
           reasoning as apps/LiveMeet/web.config, and for the same reason
           it matters more than usual for an ES module app.

           Module cache identity is keyed by the exact import URL, so a ?V=
           has to be byte-identical on the <script type="module" src> AND on
           every import specifier reaching the same file. Get that wrong and
           you don't get a stale file, you get TWO LIVE INSTANCES of the
           module with separate state. Cheaper to disable caching outright
           until this app is deployment-ready.

           The symptom when this is missing is nasty and silent: edits to
           app.js appear to do nothing, window.ttBoot is never defined, both
           screens keep their d-none and the page renders blank with no
           console error. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- clientCache above sets Cache-Control; these add Pragma+Expires
             for older intermediaries. -->
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma"        value="no-cache" />
        <add name="Expires"       value="0" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
